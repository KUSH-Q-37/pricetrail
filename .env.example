# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is committed.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# DATABASE_URL is what the application uses at runtime.
# DIRECT_URL is what Prisma Migrate uses.
#
# They differ in production: Supabase's transaction pooler (port 6543) cannot
# run DDL or advisory locks, so migrations must bypass it and connect straight
# to port 5432. Locally both point at the same container.
DATABASE_URL="postgresql://pricetrail:pricetrail_dev_password@localhost:5432/pricetrail?schema=public"
DIRECT_URL="postgresql://pricetrail:pricetrail_dev_password@localhost:5432/pricetrail?schema=public"

# Production (Supabase) would look like:
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Redis -----------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"
TZ="UTC"

# Business timezone. All timestamps are stored in UTC; this is only used to
# decide what counts as "today" for the daily tracking window.
APP_TIMEZONE="Asia/Kolkata"

# --- API -------------------------------------------------------------------
PORT="3001"
LOG_LEVEL="debug"

# Comma-separated allowlist. EMPTY MEANS CORS IS OFF (same-origin only), which
# is the correct default — a wildcard on an authenticated API is a hole, not a
# convenience. Set this to the frontend origin in Phase 4.
CORS_ORIGINS=""

# Fixed-window default applied to every route unless a handler overrides it
# with @RateLimit(). Health probes are exempt via @SkipRateLimit().
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"

# Swagger is opt-in. Leave "false" in production — the OpenAPI document is a
# complete map of the attack surface.
SWAGGER_ENABLED="true"


# --- proxy hops -------------------------------------------------------------
# How many proxy hops in front of the API to trust for X-Forwarded-For. Rate
# limiting keys anonymous callers by IP, so this must match the deployment:
# too low and every visitor shares one bucket, too high and the header can be
# forged to evade limiting. 1 for a single load balancer (Render), 2 with a CDN
# in front. Locally there is no proxy at all.
TRUST_PROXY_HOPS="0"

# --- Amazon Creators API ----------------------------------------------------
# Replaces the Product Advertising API, which Amazon retired on 15 May 2026.
# Without these, Amazon products cannot be collected at all: amazon.in answers
# every scrape with a bot challenge, so this is the only working route.
# Flipkart is unaffected and needs no credentials.
#
# The version is stamped on the credential and selects the OAuth token host.
# amazon.in is v3.2 (EU) — Amazon groups India with Europe, not the Far East.
# The partner tag is the store ID from Associates Central > Manage Your
# Tracking IDs, and must belong to the account that issued the credential.
AMAZON_CREATORS_CLIENT_ID=""
AMAZON_CREATORS_CLIENT_SECRET=""
AMAZON_CREATORS_PARTNER_TAG=""
AMAZON_CREATORS_VERSION="v3.2"

# --- catalogue discovery ----------------------------------------------------
# Enrols products nobody has searched, so the catalogue grows on its own.
# Flipkart only. Runs every 6 hours; once at the cap it costs one COUNT query
# per run and fetches nothing.
#
# DISCOVERY_MAX_LISTINGS is a storage budget, not a preference. Each tracked
# product eventually occupies ~137 KB of price history across the 15-month
# retention window, so 2500 products is roughly 350 MB — about as much as a
# 500 MB free tier can give price history. Exceeding it fills the disk, which
# stops the sweep recording ANY price, including for products people searched.
DISCOVERY_ENABLED="true"
DISCOVERY_MAX_LISTINGS="2500"
DISCOVERY_PAGES_PER_SEED="8"
DISCOVERY_PAGE_DELAY_MS="2500"
# Comma-separated. Empty uses the built-in list: electronics, electronic
# accessories, home appliances and smart home.
DISCOVERY_SEEDS=""

# --- collection tuning ------------------------------------------------------
# Minutes over which the daily sweep spreads its fetches, so it does not hit a
# marketplace in one burst.
SWEEP_WINDOW_MINUTES="360"
# Months of price history kept. Older partitions are dropped whole.
PRICE_HISTORY_RETENTION_MONTHS="15"
# Months without a search before a listing stops being collected. 0 disables.
TRACKING_RETIRE_AFTER_MONTHS="12"
