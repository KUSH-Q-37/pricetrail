# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# environment — never commit real credentials
.env
.env.local
.env.*.local
!.env.example

# prisma
packages/database/prisma/*.db
packages/database/prisma/*.db-journal
# Generated Prisma client. Emitted into the package (rather than node_modules)
# so `pnpm deploy` carries it into the Docker images — but it is still build
# output, recreated by `prisma generate`, and must not be committed.
packages/database/generated/

# logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# visual-check output from apps/web/scripts/screenshot-chart.mjs
chart-*.png

# test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# turbo
.turbo/
