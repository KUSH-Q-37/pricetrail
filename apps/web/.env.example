# Copy to .env.local (gitignored).
#
# NEXT_PUBLIC_ is required: this value is read in the browser, so it is inlined
# into the client bundle at build time. Never put a secret behind this prefix.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Must match AUTH_MODE on the API. "local-dev" signs in against the API's
# dev-token endpoint and DOES NOT CHECK PASSWORDS.
NEXT_PUBLIC_AUTH_MODE="local-dev"

# Required when NEXT_PUBLIC_AUTH_MODE is not "local-dev".
# The anon key is designed to be public — it is safe in the client bundle, and
# is not the service-role key (which must NEVER appear in frontend env).
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
